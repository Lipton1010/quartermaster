{{!--
  Quartermaster — system-adapter-aware Shared Party Inventory

  Sections, in fixed order:
    1. Header strip (optional load indicator + reference-currency total)
    2. Currency rail
    3. Custom resources (if any exist)
    4. Visible Items

  All interactive controls (drag-drop, +/− buttons, right-click menus) land
  in later steps; this template renders the current state read-only.
--}}

{{#unless backingActorPresent}}
  <div class="quartermaster-empty-state">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <p>Backing actor not initialized. Reload the world.</p>
  </div>
{{else}}
<div class="quartermaster-inventory-root {{entrySizeClass}}{{#if hasBackgroundImage}} qm-has-background{{/if}}">

  {{#if hasBackgroundImage}}
  <div class="qm-inventory-watermark" aria-hidden="true">
    <img src="{{backgroundImageSrc}}" alt="" />
  </div>
  {{/if}}

  {{!-- Header: optional system load and reference-currency total --}}
  <header class="qm-inv-header">
    {{#if capacity.supported}}
    <div class="qm-inv-capacity{{#if capacity.over}} qm-over-capacity{{/if}}">
      <i class="fa-solid fa-weight-hanging"></i>
      {{#if capacity.enforced}}
        <span class="qm-capacity-text">
          {{capacity.currentDisplay}} / {{capacity.limitDisplay}}
        </span>
        <span class="qm-capacity-bar" aria-hidden="true">
          <span class="qm-capacity-fill" style="width: {{capacity.percent}}%"></span>
        </span>
      {{else}}
        <span class="qm-capacity-text">
          {{capacity.currentDisplay}} (not enforced)
        </span>
      {{/if}}
    </div>
    {{/if}}

    <div class="qm-inv-total-value" title="Total currency value in {{totals.referenceCurrencyName}} equivalent">
      <i class="fa-solid fa-coins"></i>
      {{totals.referenceEquivalent}} {{totals.referenceCurrencySymbol}}
    </div>
  </header>

  {{!-- Currency rail --}}
  {{#if hasCurrencies}}
  <section class="qm-inv-section qm-currency-rail">
    {{#each currencies}}
      <div class="qm-currency-tile qm-currency-{{this.type}}{{#if this.isCustom}} qm-currency-custom{{/if}}"
           data-currency-id="{{this.id}}" title="{{this.name}}">
        {{#if this.hasImage}}
          <img class="qm-currency-tile-image" src="{{this.image}}" alt="" aria-hidden="true" />
        {{/if}}
        <span class="qm-currency-label">{{this.symbol}}</span>
        <span class="qm-currency-value">{{this.value}}</span>
        <div class="qm-currency-buttons">
          <button type="button"
                  class="qm-currency-btn qm-currency-remove"
                  data-action="currency-remove"
                  data-currency-id="{{this.id}}"
                  title="Remove {{this.symbol}} (shift-click to remove 1)">
            <i class="fa-solid fa-minus"></i>
          </button>
          <button type="button"
                  class="qm-currency-btn qm-currency-add"
                  data-action="currency-add"
                  data-currency-id="{{this.id}}"
                  title="Add {{this.symbol}} (shift-click to add 1)">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
    {{/each}}
  </section>
  {{/if}}

  {{!-- Custom resources --}}
  {{#if hasResources}}
  <section class="qm-inv-section qm-resources">
    <h3 class="qm-section-header">
      <i class="fa-solid fa-flask"></i> Resources
    </h3>
    <ul class="qm-resource-list">
      {{#each resources}}
        <li class="qm-resource-row{{#if this.atMax}} qm-resource-at-max{{/if}}{{#if this.atZero}} qm-resource-at-zero{{/if}}"
            data-resource-id="{{this.id}}"
            title="{{this.description}}">
          <img src="{{this.icon}}" alt="" class="qm-resource-icon" />
          <span class="qm-resource-name">{{this.name}}</span>
          <span class="qm-resource-value">{{this.displayValue}}</span>
          <div class="qm-resource-buttons">
            <button type="button"
                    class="qm-resource-btn qm-resource-remove"
                    data-action="resource-remove"
                    data-resource-id="{{this.id}}"
                    title="Remove (shift-click to remove 1)">
              <i class="fa-solid fa-minus"></i>
            </button>
            <button type="button"
                    class="qm-resource-btn qm-resource-add"
                    data-action="resource-add"
                    data-resource-id="{{this.id}}"
                    title="Add (shift-click to add 1)">
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
        </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{!-- Items list --}}
  <section class="qm-inv-section qm-items">
    <h3 class="qm-section-header">
      <i class="fa-solid fa-box"></i> Items
      <span class="qm-section-count">({{itemCount}})</span>
      <select class="qm-sort-select" name="sortOrder" title="Sort items by">
        <option value="alphabetical" {{#if settings.sortAlpha}}selected{{/if}}>A–Z</option>
        <option value="byType" {{#if sortedByType}}selected{{/if}}>By Type</option>
        <option value="currencyFirst" {{#if settings.sortCurrFirst}}selected{{/if}}>System Priority</option>
        <option value="custom" {{#if sortedCustom}}selected{{/if}}>Manual</option>
      </select>
      {{#if isGM}}
      <button type="button" data-action="manage-currencies" class="qm-section-action-btn" title="Create, edit, hide, or restore currencies">
        <i class="fa-solid fa-coins"></i> Manage Currencies
      </button>
      <button type="button" data-action="create-item" class="qm-section-action-btn" title="Create a new item in the vault">
        <i class="fa-solid fa-plus"></i> Create Item
      </button>
      {{/if}}
    </h3>

    {{#if hasItems}}
      <ol class="qm-item-list">
        {{#if sortedByType}}
          {{#each itemGroups}}
            <li class="qm-item-type-header">
              <span class="qm-type-label">{{this.label}}</span>
              <span class="qm-type-count">({{this.items.length}})</span>
            </li>
            {{#each this.items}}
              <li class="qm-item-row{{#if this.supportsIdentification}}{{#unless this.isIdentified}} qm-unidentified{{/unless}}{{/if}}"
                  data-item-id="{{this.id}}"
                  data-item-type="{{this.type}}">
                <img src="{{this.img}}" alt="" class="qm-item-icon" draggable="false" />
                <span class="qm-item-name">{{this.name}}</span>
                <span class="qm-item-quantity">
                  {{#if this.showQuantity}}×{{this.quantity}}{{/if}}
                </span>
                <div class="qm-item-meta">
                  {{#if this.hasLoad}}<span class="qm-item-load">{{this.loadDisplay}}</span>{{/if}}
                  {{#if this.hasPrice}}<span class="qm-item-price">{{this.priceDisplay}}</span>{{/if}}
                </div>
                {{#if @root.isGM}}
                <div class="qm-item-gm-actions">
                  <button type="button" class="qm-item-hide-btn" data-action="hide-item" data-item-id="{{this.id}}" title="Hide (send to Loot Prep)">
                    <i class="fa-solid fa-eye-slash"></i>
                  </button>
                  <button type="button" class="qm-item-delete-btn" data-action="delete-item" data-item-id="{{this.id}}" data-item-name="{{this.name}}" title="Delete item from vault">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
                {{/if}}
              </li>
            {{/each}}
          {{/each}}
        {{else}}
          {{#each items}}
            <li class="qm-item-row{{#if this.supportsIdentification}}{{#unless this.isIdentified}} qm-unidentified{{/unless}}{{/if}}"
                data-item-id="{{this.id}}"
                data-item-type="{{this.type}}">
              <img src="{{this.img}}" alt="" class="qm-item-icon" draggable="false" />
              <span class="qm-item-name">{{this.name}}</span>
              <span class="qm-item-quantity">
                {{#if this.showQuantity}}×{{this.quantity}}{{/if}}
              </span>
              <div class="qm-item-meta">
                {{#if this.hasLoad}}<span class="qm-item-load">{{this.loadDisplay}}</span>{{/if}}
                {{#if this.hasPrice}}<span class="qm-item-price">{{this.priceDisplay}}</span>{{/if}}
              </div>
              {{#if ../isGM}}
              {{#if ../sortedCustom}}
              <div class="qm-item-sort-actions">
                <button type="button" class="qm-sort-btn" data-action="move-item-up" data-item-id="{{this.id}}" title="Move up"><i class="fa-solid fa-chevron-up"></i></button>
                <button type="button" class="qm-sort-btn" data-action="move-item-down" data-item-id="{{this.id}}" title="Move down"><i class="fa-solid fa-chevron-down"></i></button>
              </div>
              {{/if}}
              {{/if}}
              {{#if ../isGM}}
              <div class="qm-item-gm-actions">
                <button type="button" class="qm-item-hide-btn" data-action="hide-item" data-item-id="{{this.id}}" title="Hide (send to Loot Prep)">
                  <i class="fa-solid fa-eye-slash"></i>
                </button>
                <button type="button" class="qm-item-delete-btn" data-action="delete-item" data-item-id="{{this.id}}" data-item-name="{{this.name}}" title="Delete item from vault">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
              {{/if}}
            </li>
          {{/each}}
        {{/if}}
      </ol>
    {{else}}
      <p class="qm-empty">The vault is empty.</p>
    {{/if}}
  </section>

  {{!-- Footer diagnostics --}}
  <footer class="qm-inv-footer">
    <span class="qm-inv-version">v{{moduleVersion}}</span>
    <span class="qm-inv-actor" title="Backing actor: {{backingActorName}}">
      <code>{{backingActorId}}</code>
    </span>
  </footer>

</div>
{{/unless}}
