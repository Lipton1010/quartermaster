{{#unless backingActorPresent}}
  <div class="quartermaster-empty-state">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <p>Backing actor not initialized. Reload the world.</p>
  </div>
{{else}}
<div class="qm-currency-manager-root">
  <header class="qm-currency-manager-toolbar">
    <div>
      <h2>Currencies</h2>
      <p>Set exchange rates against one fixed reference currency.</p>
    </div>
    <button type="button" data-action="add-currency" title="Add custom currency">
      <i class="fa-solid fa-plus"></i> Add Currency
    </button>
  </header>

  <div class="qm-reference-currency-control">
    <label for="qm-reference-currency"><i class="fa-solid fa-scale-balanced"></i> Reference Currency</label>
    <select id="qm-reference-currency" class="qm-reference-currency-select">
      {{#each referenceOptions}}
        <option value="{{this.id}}"{{#if this.isReference}} selected{{/if}}{{#unless this.canBeReference}} disabled{{/unless}}>
          {{this.name}} ({{this.symbol}}){{#unless this.canBeReference}} — set a rate first{{/unless}}
        </option>
      {{/each}}
    </select>
    <p>Totals and approval thresholds use {{referenceCurrency.symbol}}. Changing the reference preserves exchange relationships and rebases the existing threshold.</p>
  </div>

  <div class="qm-currency-manager-list">
    {{#each currencies}}
    <article class="qm-currency-manager-row{{#if this.hidden}} qm-currency-is-hidden{{/if}}"
             data-currency-id="{{this.id}}">
      <div class="qm-currency-manager-image">
        {{#if this.hasImage}}
          <img src="{{this.image}}" alt="" />
        {{else}}
          <i class="fa-solid fa-coins"></i>
        {{/if}}
      </div>
      <div class="qm-currency-manager-details">
        <div class="qm-currency-manager-name">
          <strong>{{this.name}}</strong>
          <span>{{this.symbol}}</span>
          <span class="qm-currency-kind">{{this.kindLabel}}</span>
        </div>
        <div class="qm-currency-manager-meta">
          <span>{{this.value}} {{this.symbol}}</span>
          <span>{{this.conversionLabel}}</span>
          {{#if this.hasWeightLabel}}<span>{{this.weightLabel}}</span>{{/if}}
          <span>{{this.visibilityLabel}}</span>
        </div>
      </div>
      <div class="qm-currency-manager-actions">
        <button type="button" data-action="toggle-currency" data-currency-id="{{this.id}}"
                title="{{#if this.canHide}}{{this.visibilityActionLabel}} {{this.name}}{{else}}The reference currency cannot be hidden{{/if}}"
                {{#unless this.canHide}}disabled{{/unless}}>
          <i class="{{this.visibilityIcon}}"></i>
        </button>
        <button type="button" data-action="edit-currency" data-currency-id="{{this.id}}"
                title="Edit {{this.name}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        {{#if this.isCustom}}
        <button type="button" data-action="delete-currency" data-currency-id="{{this.id}}"
                class="qm-currency-delete"
                title="{{#if this.canDelete}}Delete {{this.name}}{{else}}Choose another reference currency before deleting this one{{/if}}"
                {{#unless this.canDelete}}disabled{{/unless}}>
          <i class="fa-solid fa-trash"></i>
        </button>
        {{/if}}
      </div>
    </article>
    {{/each}}
  </div>
</div>
{{/unless}}
